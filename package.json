{
  "name": "paperclip-office",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "Your Paperclip company as a live pixel office: every agent at a desk, work moving between them",
  "scripts": {
    "fetch-art": "node ./scripts/fetch-art.mjs",
    "prebuild": "node ./scripts/fetch-art.mjs",
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "demo": "node demo/build.mjs"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "paperclip-plugin",
    "ai-agents",
    "agent-company",
    "pixel-art",
    "office",
    "pixijs",
    "dashboard",
    "visualization",
    "react"
  ],
  "author": "Kshitijm7",
  "license": "Apache-2.0",
  "dependencies": {
    "pixi.js": "8.5.1",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "2026.831.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.8",
    "esbuild": "^0.27.3",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kshitijm7/paperclip-office.git"
  },
  "homepage": "https://github.com/Kshitijm7/paperclip-office#readme",
  "bugs": {
    "url": "https://github.com/Kshitijm7/paperclip-office/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
